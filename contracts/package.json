{
  "name": "trustlance-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for TrustLance escrow and dispute resolution",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "node": "hardhat node",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "seed:arbitrators": "hardhat run scripts/seedArbitrators.js --network localhost",
    "seed:arbitrators:sepolia": "hardhat run scripts/seedArbitrators.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.18",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.14"
  }
}
