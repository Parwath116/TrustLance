# ==============================================================================
# TrustLance - Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR PRIVATE KEYS
# Copy this file to .env and configure your local or testnet values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Blockchain RPC & Network Connection
# ------------------------------------------------------------------------------
# RPC_URL is used by Backend, Indexer, and E2E scripts.
# - Local Hardhat node: http://127.0.0.1:8545 (CHAIN_ID=31337)
# - Sepolia mode: Set RPC_URL to your Sepolia RPC endpoint (same as SEPOLIA_RPC_URL) and CHAIN_ID=11155111
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# SEPOLIA_RPC_URL is used ONLY by Hardhat deployment and verification scripts
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id

# Deployer private key (0x-prefixed 32-byte hex).
# Required ONLY when deploying to public testnets like Sepolia. Leave unset or empty for local testing.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key for contract verification on Sepolia
ETHERSCAN_API_KEY=

# ------------------------------------------------------------------------------
# Contract Deployment & Arbitration Configuration
# ------------------------------------------------------------------------------
# Path to shared deployment output file containing {address, abi, deploymentBlock, chainId}
# - Local mode: ./contracts/deployments/localhost.json
# - Sepolia mode: ./contracts/deployments/sepolia.json
DEPLOYMENT_FILE=./contracts/deployments/localhost.json

# Whitelisted Arbitrator Addresses (comma-separated)
# NOTE: The default addresses below are Hardhat default public test accounts (accounts #1, #2, #3).
# FOR LOCAL DEVELOPMENT ONLY. In Sepolia mode, replace these with your actual testnet arbitrator wallet addresses.
ARBITRATOR_ADDRESSES=0x70997970C51812dc3A010C7d01b50e0d17dc79C8,0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC,0x90F79bf6EB2c4f870365E785982E1f101E93b906

# Number of arbitrator votes required to resolve a dispute (must be odd, default 3)
PANEL_SIZE=3

# Voting window in seconds before resolveExpiredDispute can be invoked
# (e.g. 604800 = 7 days for production/Sepolia; short duration like 300 for testing)
VOTING_PERIOD=604800

# ------------------------------------------------------------------------------
# Backend & Indexer Configuration
# ------------------------------------------------------------------------------
PORT=5000

# MongoDB Connection URI:
# - Local host direct: mongodb://localhost:27017/trustlance
# - Docker mode: mongodb://mongo:27017/trustlance (Docker Compose automatically overrides this via environment)
MONGODB_URI=mongodb://localhost:27017/trustlance

# JWT Secret for authentication session signing (must be >= 32 characters and NOT placeholder)
# The backend will strictly fail to boot if missing, shorter than 32 characters, or left as the placeholder!
JWT_SECRET=replace_this_with_a_secure_random_string_min_32_chars_long

# CORS Allowed Origin for Express server
CORS_ORIGIN=http://localhost:8095

# Block batch size for indexer catch-up queries (eth_getLogs)
INDEXER_BATCH_SIZE=500

# Polling interval in milliseconds for the indexer event loop
INDEXER_POLL_INTERVAL_MS=6000

# ------------------------------------------------------------------------------
# Frontend Configuration (Dev)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
